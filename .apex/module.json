{
  "schemaVersion": 1,
  "id": "bili-peek",
  "projectId": "bili-peek",
  "projectName": "Bili-Peek",
  "projectDescription": "一键启停 B站双图与 Obsidian 片段助手；后台运行，不自动打开网页。",
  "name": "Bili-Peek 与片段助手",
  "version": "0.3.28",
  "projectRoot": ".",
  "requiresAdmin": false,
  "singleInstance": true,
  "timeoutSeconds": 30,
  "actions": {
    "run": {
      "program": "powershell.exe",
      "cwd": "{project_root}",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "{module_dir}\\runner.ps1", "-Action", "run", "-ResultPath", "{result_path}"]
    },
    "stop": {
      "program": "powershell.exe",
      "cwd": "{project_root}",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "{module_dir}\\runner.ps1", "-Action", "stop", "-ResultPath", "{result_path}"]
    }
  }
}
